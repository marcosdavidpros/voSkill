# Copy this file to .env and replace the placeholders locally.
ORACLE_USER=ITB2CTRF
ORACLE_PASSWORD=replace_with_local_secret
ORACLE_DSN=//localhost:1521/FREEPDB1

# Portal currently uses ldap://; credentials are sent without transport encryption.
# Use only on a trusted isolated network. Prefer ldaps:// when available.
LDAP_URL=ldap://ldap.example.invalid:389
LDAP_DOMAIN=EMPRESA\
# Kept for parity with the Portal; simple bind does not search this base DN.
LDAP_BASE_DN=DC=EMPRESA,DC=local
# Portal values are milliseconds; the NorteiaSkills converts them to seconds for ldap3.
LDAP_TIMEOUT=10000
LDAP_CONNECT_TIMEOUT=10000
LDAP_FOLLOW_REFERRALS=false
# Used only with ldaps://, when the corporate CA is not in the OS trust store.
LDAP_CA_CERT=

# Portal authorization Oracle account; grant only required PARAM_* reads and
# UPDATE on PARAM_USUARIOS.ULTIMO_LOGIN.
PORTAL_ORACLE_USER=replace_with_portal_service_user
PORTAL_ORACLE_PASSWORD=replace_with_local_secret
PORTAL_ORACLE_DSN=//portal-host:1521/service_name

# Generate a distinct random value per environment; minimum 32 bytes.
VOSKILL_SESSION_SECRET=replace_with_random_secret_at_least_32_bytes
VOSKILL_SESSION_MAX_AGE=1800
VOSKILL_SESSION_COOKIE_SECURE=1